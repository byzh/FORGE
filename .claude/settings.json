{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet build FORGE.slnx --nologo -q 2>&1 | tail -5"
          },
          {
            "type": "command",
            "command": "dotnet test FORGE.Tests/FORGE.Tests.csproj --nologo -q 2>&1 | tail -10"
          }
        ]
      }
    ]
  }
}
